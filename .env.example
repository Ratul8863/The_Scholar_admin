# Server only. Never prefix these with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scholar
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional transactional email. Without these, invitation links are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=Scholar <research@example.com>
EMAIL_NOTIFICATIONS=false

# Used only by `npm run seed` to create the first admin. Not a shared team password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Scholar Admin
SEED_ADMIN_PASSWORD=change-this-password-1

# Set true on MongoDB Atlas replica sets.
MONGO_TRANSACTIONS=false
